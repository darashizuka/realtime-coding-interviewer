# Copy this file to .env and fill in your key.
#   cp .env.example .env

# Required. Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional. Groq retires models periodically; override if the default 404s.
# To see what your key can reach:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# qwen/qwen3.8-27b is noticeably faster if you prefer latency over quality.
GROQ_MODEL=openai/gpt-oss-120b
